{
  "name": "tms-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ratchet": "node scripts/ci/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/ci/lint-ratchet.mjs --update",
    "audit:ratchet": "node scripts/ci/audit-ratchet.mjs",
    "audit:ratchet:update": "node scripts/ci/audit-ratchet.mjs --update",
    "scan:secrets": "node scripts/ci/scan-secrets.mjs",
    "check:test-hygiene": "node scripts/ci/check-test-hygiene.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:assert-scripts": "tsx src/lib/utils/daily-sheet-csv.test.ts && tsx src/lib/utils/package-form-payload.test.ts && tsx src/lib/utils/sheet-row-fault.test.ts",
    "test:qa-security": "node scripts/qa-frontend-security-unit.mjs",
    "test:role-audit": "node scripts/role-audit-middleware.mjs",
    "verify": "npm run typecheck && npm run check:test-hygiene && npm run scan:secrets && npm run lint:ratchet && npm run audit:ratchet && npm run test:ci && npm run test:assert-scripts && npm run test:qa-security",
    "check:routes-built": "node scripts/ci/check-routes-built.mjs",
    "verify:full": "npm run verify && npm run build && npm run check:routes-built"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@tanstack/react-table": "^8.21.2",
    "@types/axios": "^0.14.4",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^0.487.0",
    "next": "^16.3.5",
    "pica": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.5.2",
    "react-redux": "^9.2.0",
    "recharts": "^3.10.1",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pica": "^9.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.16",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8.34.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "react-day-picker": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
